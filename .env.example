# ==========================================
# Christmas Together - Environment Variables
# ==========================================

# Node Environment
NODE_ENV=production
PORT=3000

# Application URL (Used for invitation links and password reset emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection
# In Docker: postgresql://postgres:your_secure_password@db:5432/christmas_together?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/christmas_together?schema=public"

# Session & JWT Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-very-long-random-secret-key-at-least-32-chars"

# Brevo (Sendinblue) Transactional Email API
# Get key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS="santa@yourfamilydomain.com"
EMAIL_FROM_NAME="Christmas Together"

# Music Storage Configuration
# Local disk path inside container or host for uploaded music tracks
UPLOAD_DIR="./uploads/music"
MAX_UPLOAD_SIZE_MB=15

# Admin Seed Account (Optional: auto-seeded on first run if configured)
ADMIN_DEFAULT_EMAIL="admin@family.com"
ADMIN_DEFAULT_PASSWORD="ChangeMeInProduction123!"
ADMIN_DEFAULT_NAME="Christmas Organizer"
